{
  "version": 2,
  "rewrites": [
    {
      "source": "/query",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/documents",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/documents/:filename",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/dist/assets/$1"
    },
    {
      "source": "/((?!api|query).*\\..*)",
      "destination": "/frontend/dist/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
